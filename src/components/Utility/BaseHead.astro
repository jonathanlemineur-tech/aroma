---
import { Font } from "astro:assets";
import { SITE_NAME, SITE_DESCRIPTION, BUSINESS } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.png",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "FlowerShop",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  image: socialImage.toString(),
  url: Astro.site?.toString(),
  telephone: BUSINESS.phoneHref.replace("tel:", ""),
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.streetAddress,
    postalCode: BUSINESS.postalCode,
    addressLocality: BUSINESS.city,
    addressCountry: BUSINESS.country,
  },
  openingHours: BUSINESS.openingHours,
  sameAs: Object.values(BUSINESS.socials),
};
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-cabinet-grotesk" preload />
<Font cssVariable="--font-tenor-sans" preload />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#141414" />
<meta name="generator" content={Astro.generator} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
