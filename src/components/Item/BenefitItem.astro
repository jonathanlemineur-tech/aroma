---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Icon from "@/components/Media/Icon.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** An SVG imported from `src/assets`. */
  icon: SvgComponent;
  /** The benefit's title. */
  heading: string;
  /** A short line under the title. */
  text: string;
}

const {
  render = true,
  icon,
  heading,
  text,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div class:list={["benefit-item_wrap", className]} {...rest}>
      <Icon src={icon} variant="large" class="benefit-item_icon color-brand" />
      <Heading tag="h3" variant="h5" class="color-brand benefit-item_heading">
        {heading}
      </Heading>
      <Paragraph>{text}</Paragraph>
    </div>
  )
}

<style is:global>
  @layer components {
    .benefit-item_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
    }

    .benefit-item_icon {
      --_size: 2.5rem;
    }

    .benefit-item_heading {
      display: flex;
      align-items: center;
      min-height: 2lh;
    }
  }
</style>
