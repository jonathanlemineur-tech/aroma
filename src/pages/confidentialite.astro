---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
---

<Layout title="Politique de confidentialité">
  <Section paddingTop="large" paddingBottom="large">
    <ContentWrapper>
      <Eyebrow>Confidentialité</Eyebrow>
      <Heading tag="h1" class="heading-accent">
        Politique de <strong>confidentialité</strong>
      </Heading>
      <Paragraph variant="large" maxWidth={60}>
        Cette page est un modèle. Elle sera complétée avec la politique de
        confidentialité réelle de l'entreprise (données collectées, cookies,
        droits des utilisateurs) avant la mise en ligne du site.
      </Paragraph>
    </ContentWrapper>
  </Section>
</Layout>
